<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" prefWidth="460" style="-fx-background-color: white; -fx-padding: 20;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ItemDetailController">

    <Label fx:id="titleLabel" text="Chi tiet san pham"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
    <Label fx:id="categoryStatusLabel" text="Danh muc | Trang thai"
           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>

    <Separator/>

    <VBox spacing="8">
        <Label text="Thong tin chi tiet:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <Label fx:id="detailsLabel" wrapText="true" style="-fx-text-fill: #475569;"/>

        <Label fx:id="priceLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
        <Label fx:id="incrementLabel" style="-fx-text-fill: #334155;"/>
        <Label fx:id="shippingLabel" style="-fx-text-fill: #334155;"/>
        <Label fx:id="leaderLabel" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
    </VBox>

    <Separator/>

    <HBox alignment="CENTER_RIGHT">
        <padding><Insets top="6"/></padding>
        <Button text="Dong" onAction="#handleClose"
                style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>
</VBox>
